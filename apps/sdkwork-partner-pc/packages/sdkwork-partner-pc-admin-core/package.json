{
  "name": "@sdkwork/partner-pc-admin-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Partner admin core: backend SDK client factory, typed service helpers, and shared admin UI primitives.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts",
      "default": "./src/ui/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sdkwork/partner-backend-sdk": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@sdkwork/partner-backend-sdk": "workspace:*",
    "react": ">=18.2.0 <20.0.0"
  },
  "sdkwork": {
    "workspace": "sdkwork-partner",
    "architecture": "pc-react",
    "domain": "commerce",
    "capability": "partner",
    "status": "ready"
  }
}
